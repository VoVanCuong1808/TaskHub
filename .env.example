TASKHUB_APP_NAME=TaskHub
TASKHUB_VERSION=0.1.0
TASKHUB_ENVIRONMENT=local
TASKHUB_DEBUG=false
TASKHUB_API_V1_PREFIX=/api/v1
TASKHUB_HOST=127.0.0.1
TASKHUB_PORT=8000
TASKHUB_DATABASE_URL=postgresql+asyncpg://postgres:taskhub@127.0.0.1:5433/taskhub
TASKHUB_DATABASE_PASSWORD=
# Full Compose requires this and passes it separately to PostgreSQL and the app.
TASKHUB_POSTGRES_PASSWORD=
TASKHUB_DATABASE_ECHO=false
TASKHUB_REDIS_URL=redis://127.0.0.1:6379/0
TASKHUB_JWT_SECRET_KEY=
TASKHUB_ACCESS_TOKEN_MINUTES=15
TASKHUB_REFRESH_TOKEN_DAYS=30
TASKHUB_REFRESH_COOKIE_SECURE=true
TASKHUB_REFRESH_COOKIE_SAMESITE=lax
TASKHUB_FRONTEND_ORIGINS=[]
# Host development: blank disables mail. Full Compose uses internal Mailpit.
TASKHUB_SMTP_HOST=
TASKHUB_SMTP_PORT=1025
TASKHUB_SMTP_FROM_EMAIL=no-reply@example.com
TASKHUB_SMTP_USERNAME=
TASKHUB_SMTP_PASSWORD=
TASKHUB_SMTP_STARTTLS=false
TASKHUB_SMTP_TIMEOUT_SECONDS=5
